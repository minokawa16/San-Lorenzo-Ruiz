{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/run-reminders.php",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/ParishSystem/?$",
      "dest": "https://tugon-web-production.up.railway.app/"
    },
    {
      "src": "^/ParishSystem/(.*)$",
      "dest": "https://tugon-web-production.up.railway.app/$1"
    },
    {
      "src": "^/api/run-reminders(?:\\.php)?/?$",
      "dest": "https://tugon-web-production.up.railway.app/api/run-reminders.php"
    },
    {
      "src": "^/api/dashboard/stats/?$",
      "dest": "https://tugon-web-production.up.railway.app/api/dashboard/stats.php"
    },
    {
      "src": "^/api/ai-assistant/?$",
      "dest": "https://tugon-web-production.up.railway.app/api/ai-assistant.php"
    },
    {
      "src": "^/api/ai-health/?$",
      "dest": "https://tugon-web-production.up.railway.app/api/ai-health.php"
    },
    {
      "src": "^/(.*)$",
      "dest": "https://tugon-web-production.up.railway.app/$1"
    }
  ]
}
