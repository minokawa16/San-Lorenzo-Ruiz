# Local secrets
.env
.env.*
!.env.example
config/db.local.php

# Node dependencies and generated output
node_modules/
.vercel/
dist/
coverage/
npm-debug.log*
__pycache__/
*.py[cod]

# Runtime data and private user content
cache/*
logs/*
storage/tmp_ids/*
sess_*
uploads/announcements/*
uploads/live_faces/*
uploads/valid_ids/*
uploads/request_requirements/*

# Local backups and exports
backups/*.sql
backups/*.zip
*.zip
*_recovery_dump.sql

# Keep access-control placeholders in otherwise ignored directories
!backups/.htaccess
!backups/index.php
!uploads/announcements/.htaccess
!uploads/announcements/index.php
!uploads/request_requirements/.htaccess
!uploads/request_requirements/index.php
.codex-deploy-clean/
