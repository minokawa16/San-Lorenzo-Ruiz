# Application
APP_ENV=production
APP_URL=https://your-domain.example
APP_BASE_PATH=/
LOG_LEVEL=info
ERROR_REPORT_EMAIL=tugonparish@gmail.com
PASSWORD_MIN_LENGTH=12
ENCRYPTION_KEY=replace_with_64_random_hex_characters
JWT_SECRET_KEY=replace_with_a_different_64_random_hex_value
ALLOWED_ORIGINS=https://your-domain.example

# MySQL (Railway MYSQL* variables are also detected automatically)
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USER=tugon
DB_PASSWORD=replace_me
DB_NAME=parish_management_system

# Gmail SMTP is required for administrator MFA. Use a Google App Password.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tugonparish@gmail.com
MAIL_PASSWORD=replace_with_google_app_password
MAIL_ENCRYPTION=tls
MAIL_HTTP_ENDPOINT=
MAIL_HTTP_TOKEN=
MAIL_FROM_ADDRESS=tugonparish@gmail.com
MAIL_FROM_NAME="San Lorenzo Ruiz Mission Station"
MAIL_TIMEOUT=10

# Persistent Railway volume and optional one-instance migration on startup
TUGON_DATA_DIR=/var/www/tugon-data
TUGON_RUN_MIGRATIONS=false
TUGON_WORKER_INTERVAL_SECONDS=60
TUGON_RUN_EMBEDDED_WORKER=false

# Optional Railway-hosted Gemini gateway
GEMINI_GATEWAY_URL=http://tugon-ai.railway.internal:3001/api/chat

# Optional SMS delivery
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
