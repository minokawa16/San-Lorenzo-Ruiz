# Application
APP_ENV=production
ENCRYPTION_KEY=generate_a_random_64_character_hex_value
JWT_SECRET_KEY=generate_a_different_random_value

# MySQL (Railway MYSQL* variables are also detected automatically)
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USER=tugon
DB_PASSWORD=replace_me
DB_NAME=parish_management_system

# Mail (optional)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="San Lorenzo Ruiz Mission Station"

# Optional Railway-hosted Gemini gateway
GEMINI_GATEWAY_URL=http://tugon-ai.railway.internal:3001/api/chat

# Optional SMS delivery
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
